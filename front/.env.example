# URL base de la API. Si no se define, http.ts usa "/api/v1" relativo
# (mismo origen, útil detrás de un proxy en producción).
# Ejemplo en desarrollo: VITE_API_URL=http://localhost:3000/api/v1
VITE_API_URL=

# Credenciales de un usuario dedicado (rol LECTOR) usado para entrar directo
# al menú sin mostrar el login (demo a directivos). Creá ese usuario con
# `npm run crear-admin` en back/ eligiendo rol LECTOR. Si se dejan vacías,
# la app se comporta como antes: pide login normal.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
